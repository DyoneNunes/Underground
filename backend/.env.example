# Configurações do Servidor Backend
PORT=3006
NODE_ENV=development

# Configurações de Conexão com o Banco de Dados (Host + Porta do repository 'database')
DB_HOST=underground_db
DB_PORT=5432
DB_USER=underground
DB_PASSWORD=underground_secret
DB_NAME=underground_tattoo
DATABASE_URL="postgresql://underground:underground_secret@underground_db:5432/underground_tattoo?schema=public"

# Autenticação JWT
# Obrigatório, >=32 chars. Gere com: openssl rand -hex 48 (a API não sobe com valor fraco/padrão)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# URL do Frontend (CORS)
FRONTEND_HOST=localhost
FRONTEND_PORT=3004
FRONTEND_URL="http://localhost:3004"
