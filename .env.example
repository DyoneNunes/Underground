# ============================================================================
# Variáveis do docker-compose.yml da raiz:   cp .env.example .env
# Depois:  docker compose up -d --build
# ============================================================================

# --- Banco (PostgreSQL) ---
POSTGRES_USER=underground
POSTGRES_PASSWORD=            # obrigatório — gere com: openssl rand -hex 24
POSTGRES_DB=underground_tattoo
POSTGRES_PORT=5434            # publicado só em 127.0.0.1 (POSTGRES_BIND p/ mudar)

# --- pgAdmin ---
PGADMIN_EMAIL=admin@underground.com
PGADMIN_PASSWORD=             # obrigatório
PGADMIN_PORT=5050             # publicado só em 127.0.0.1 (PGADMIN_BIND p/ mudar)

# --- API ---
# Obrigatório, >=32 chars. Gere com: openssl rand -hex 48 (a API não sobe com valor fraco/padrão)
JWT_SECRET=
JWT_EXPIRES_IN=7d
BACKEND_PORT=3006
# Atrás de proxy reverso (nginx/traefik): número de saltos confiáveis, ex.: 1
TRUST_PROXY=

# --- Frontend ---
FRONTEND_PORT=3004
FRONTEND_URL=http://localhost:3004          # usada no CORS da API
NEXT_PUBLIC_API_URL=http://localhost:3006/api  # embutida no bundle durante o build

# --- Seed ---
# Roda SOMENTE se o banco estiver vazio (sem sites e sem usuários). Nunca em banco com dados.
SEED_ON_EMPTY=true
SEED_ADMIN_PASSWORD=          # senha das contas iniciais (vazio = admin123 — troque!)
